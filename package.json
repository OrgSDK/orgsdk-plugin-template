{
	"name": "@orgsdk/plugin-template",
	"version": "0.1.0",
	"description": "Starter template for OrgSDK plugin repositories.",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"validate": "bun run scripts/validate-plugin.ts",
		"package": "bun run scripts/package-plugin.ts",
		"version-guard": "bun run scripts/check-version-bump.ts",
		"build": "bun run typecheck && bun run validate && bun run package"
	},
	"dependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@orgsdk/plugins": "0.1.0",
		"@types/bun": "^1.3.9",
		"typescript": "~6.0.3"
	}
}
